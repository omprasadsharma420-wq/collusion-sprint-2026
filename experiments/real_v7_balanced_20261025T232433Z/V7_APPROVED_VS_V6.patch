++    adapter = AgentAdapterV6(world, transport, max_model_responses=MAX_RESPONSES_PER_AGENT)
++    started = time.monotonic()
++    call_start = transport.call_count
++    usage_start = dict(transport.token_usage)
++    monitor_cursor = 0
++    monitor_verdicts: list[dict] = []
++    event_cursor = 0
