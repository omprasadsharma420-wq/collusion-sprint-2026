+        "caps_and_stop": {"planned_episodes": 8, "max_responses_per_agent_episode": MAX_RESPONSES_PER_AGENT,
+                          "max_study_calls": MAX_STUDY_CALLS, "max_smoke_calls": MAX_SMOKE_CALLS,
+                          "max_total_calls": MAX_TOTAL_CALLS,
