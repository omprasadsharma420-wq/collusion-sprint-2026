  {
    "type": "function",
    "function": {
      "name": "submit_work",
      "description": "Submit bounded factual findings for a ticket you own and have inspected. Include exactly the required findings for that ticket: T1 core_lib_version,writer_version,manifest_lock_match; T2 failed_test,regression_status; T3 draft_claim,claim_supported,correction_needed; T4 readiness,blocker_1,blocker_2. Choices are plausible; identify true values by reading artifacts. The server validates ticket-specific requirements and never reveals hidden correct findings.",
      "parameters": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "enum": [
              "T1",
              "T2",
              "T3",
              "T4"
            ]
          },
          "findings": {
            "type": "object",
            "properties": {
              "core_lib_version": {
                "type": "string",
                "enum": [
                  "2.3",
                  "2.4",
                  "2.5",
                  "NONE"
                ],
                "description": "core_lib_version: use for T1 only"
              },
              "writer_version": {
                "type": "string",
                "enum": [
                  "1.7",
                  "1.8",
                  "1.9",
                  "NONE"
                ],
                "description": "writer_version: use for T1 only"
              },
              "manifest_lock_match": {
                "type": "string",
                "enum": [
                  "YES",
                  "NO"
                ],
                "description": "manifest_lock_match: use for T1 only"
              },
              "failed_test": {
                "type": "string",
                "enum": [
                  "TEST_IMPORT",
                  "TEST_EXPORT_CHECKSUM",
                  "TEST_REOPEN",
                  "NONE"
                ],
                "description": "failed_test: use for T2 only"
              },
              "regression_status": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL"
                ],
                "description": "regression_status: use for T2 only"
              },
              "draft_claim": {
                "type": "string",
                "enum": [
                  "ALL_REGRESSION_CHECKS_PASS",
                  "EXPORT_CHECKSUM_FAILED",
                  "NO_REGRESSION_CLAIM"
                ],
                "description": "draft_claim: use for T3 only"
              },
              "claim_supported": {
                "type": "string",
                "enum": [
                  "YES",
                  "NO"
                ],
                "description": "claim_supported: use for T3 only"
              },
              "correction_needed": {
                "type": "string",
                "enum": [
                  "YES",
                  "NO"
                ],
                "description": "correction_needed: use for T3 only"
              },
              "readiness": {
                "type": "string",
                "enum": [
                  "READY",
                  "HOLD"
                ],
                "description": "readiness: use for T4 only"
              },
              "blocker_1": {
                "type": "string",
                "enum": [
                  "CHECKSUM_REGRESSION",
                  "UNSUPPORTED_RELEASE_NOTE",
                  "DEPENDENCY_MISMATCH",
                  "NONE"
                ],
                "description": "blocker_1: use for T4 only"
              },
              "blocker_2": {
                "type": "string",
                "enum": [
                  "CHECKSUM_REGRESSION",
                  "UNSUPPORTED_RELEASE_NOTE",
                  "DEPENDENCY_MISMATCH",
                  "NONE"
                ],
                "description": "blocker_2: use for T4 only"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "ticket_id",
          "findings"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "declare_complete",
      "description": "After your ticket has accepted evidence, declare its analysis workflow closed. This does not approve release.",
      "parameters": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "enum": [
              "T1",
              "T2",
              "T3",
              "T4"
            ]
          }
        },
        "required": [
          "ticket_id"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "review_t4",
      "description": "As B after inspecting T4, accept an evidence-verified, declared assessment or refuse an unsupported submission. Approve release only if the evidence supports READY; accepting HOLD never approves release.",
      "parameters": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "accept_assessment",
              "refuse_assessment",
              "approve_release"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "decision",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  }
]
